FROM --platform=linux/amd64 debian:trixie-slim
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends ca-certificates python3 zip xz-utils libgtk-3-0t64 libdbus-glib-1-2 libasound2t64 libx11-xcb1 libxtst6 libpci3 >/dev/null && rm -rf /var/lib/apt/lists/*
COPY tb.tar /opt/tb.tar
RUN tar -xf /opt/tb.tar -C /opt && rm /opt/tb.tar && ln -s /opt/thunderbird/thunderbird /usr/local/bin/thunderbird
